{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/data/token-usage.json", "destination": "/api/token-usage" },
    { "source": "/tokenmaxxing", "destination": "/tokenmaxxing/index.html" },
    { "source": "/tokenmaxxing/", "destination": "/tokenmaxxing/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ]
}
